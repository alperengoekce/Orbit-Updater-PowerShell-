<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orbit Updater"
        Width="1180" Height="790" MinWidth="1000" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <SolidColorBrush x:Key="PageBrush" Color="#F4F7FA" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="TextBrush" Color="#172033" />
        <SolidColorBrush x:Key="MutedBrush" Color="#667085" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#475467" />
        <SolidColorBrush x:Key="LineBrush" Color="#E2E8F0" />
        <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="HoverBrush" Color="#F1F5F9" />
        <SolidColorBrush x:Key="PressedBrush" Color="#E2E8F0" />
        <SolidColorBrush x:Key="SidebarBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SidebarElevatedBrush" Color="#F1F5F9" />
        <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#E6F3FF" />
        <SolidColorBrush x:Key="SidebarTextBrush" Color="#172033" />
        <SolidColorBrush x:Key="SidebarMutedBrush" Color="#667085" />

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#1D4ED8" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#1E40AF" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="15,9" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource HoverBrush}" /><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#94A3B8" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource PressedBrush}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Foreground" Value="#B42318" />
            <Setter Property="BorderBrush" Value="#FECDCA" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="22" />
        </Style>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,11" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource SidebarElevatedBrush}" /></Trigger>
                            <Trigger Property="Tag" Value="Selected"><Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource SidebarSelectedBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="44" Height="24">
                            <Border x:Name="ToggleTrack" Background="{DynamicResource LineBrush}" CornerRadius="12" />
                            <Ellipse x:Name="ToggleKnob" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="3,0" Effect="{x:Null}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="ToggleTrack" Property="Background" Value="#0891B2" /><Setter TargetName="ToggleKnob" Property="HorizontalAlignment" Value="Right" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ToggleTrack" Property="Opacity" Value="0.45" /><Setter TargetName="ToggleKnob" Property="Opacity" Value="0.7" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderDecreaseStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="#0891B2" Height="4" CornerRadius="2" VerticalAlignment="Center" /></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SliderIncreaseStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="{DynamicResource LineBrush}" Height="4" CornerRadius="2" VerticalAlignment="Center" /></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SliderThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="18" /><Setter Property="Height" Value="18" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border x:Name="ThumbBorder" Background="{DynamicResource SurfaceBrush}" BorderBrush="#0891B2" BorderThickness="3" CornerRadius="9" /><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbBorder" Property="Background" Value="#CFFAFE" /></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbBorder" Property="Background" Value="#67E8F9" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="IntervalSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="26" /><Setter Property="Focusable" Value="True" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Margin="8,0"><Track x:Name="PART_Track" Orientation="Horizontal" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}" Style="{StaticResource SliderDecreaseStyle}" /></Track.DecreaseRepeatButton><Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}" Style="{StaticResource SliderIncreaseStyle}" /></Track.IncreaseRepeatButton><Track.Thumb><Thumb Style="{StaticResource SliderThumbStyle}" /></Track.Thumb></Track></Grid></ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Grid Width="18" Height="18" Background="Transparent"><Ellipse x:Name="RadioOuter" Fill="{DynamicResource InputBrush}" Stroke="{DynamicResource LineBrush}" StrokeThickness="1.5" /><Ellipse x:Name="RadioDot" Width="8" Height="8" Fill="#0891B2" Visibility="Collapsed" /></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="RadioOuter" Property="Stroke" Value="#0891B2" /><Setter TargetName="RadioDot" Property="Visibility" Value="Visible" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RadioOuter" Property="Stroke" Value="#22D3EE" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,8" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemBorder" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="16,13"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="BorderBrush" Value="#0891B2" /><Setter TargetName="ItemBorder" Property="BorderThickness" Value="2" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="218" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="21,25,18,20">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="36" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Image x:Name="SidebarLogo" Width="43" Height="43" Stretch="Uniform" />
                    <StackPanel Margin="11,3,0,0">
                        <TextBlock Text="ORBIT" Foreground="{DynamicResource SidebarMutedBrush}" FontSize="10" FontWeight="Bold" />
                        <TextBlock Text="Auto Updater" Foreground="{DynamicResource SidebarTextBrush}" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="2">
                    <Button x:Name="OverviewNavButton" Tag="Selected" Style="{StaticResource NavButton}" Margin="0,0,0,4"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons" Foreground="#38BDF8" FontSize="15" /><TextBlock Text="Overview" Margin="11,0,0,0" /></StackPanel></Button>
                    <Button x:Name="HistoryNavButton" Style="{StaticResource NavButton}" Margin="0,0,0,4"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81C;" FontFamily="Segoe Fluent Icons" Foreground="#38BDF8" FontSize="15" /><TextBlock Text="History" Margin="11,0,0,0" /></StackPanel></Button>
                    <Button x:Name="SettingsNavButton" Style="{StaticResource NavButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" Foreground="#38BDF8" FontSize="15" /><TextBlock Text="Settings" Margin="11,0,0,0" /></StackPanel></Button>
                </StackPanel>
                <StackPanel Grid.Row="4">
                    <Border Background="{DynamicResource SidebarElevatedBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <StackPanel><TextBlock Text="BACKGROUND STATUS" Foreground="#0891B2" FontSize="9" FontWeight="Bold" /><TextBlock x:Name="SidebarScheduleText" Text="Automatic checks on&#x0a;Automatic installation off&#x0a;Notifications on" Foreground="{DynamicResource SidebarTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel>
                    </Border>
                    <TextBlock x:Name="SidebarVersionText" Text="0.9.1-beta.1  |  Windows 11" Foreground="{DynamicResource SidebarMutedBrush}" FontSize="10" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="90" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="32,19,34,17">
                <Grid>
                    <StackPanel><TextBlock x:Name="HeaderTitle" Text="Overview" Foreground="{DynamicResource TextBrush}" FontSize="24" FontWeight="SemiBold" /><TextBlock x:Name="HeaderSubtitle" Text="Manage your Winget updates in one place." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,0,0" /></StackPanel>
                    <Border x:Name="HeaderStatusPill" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#F3F4F6" CornerRadius="16" Padding="11,7"><StackPanel Orientation="Horizontal"><Ellipse x:Name="HeaderStatusDot" Width="7" Height="7" Fill="#6B7280" Margin="0,0,7,0" VerticalAlignment="Center" /><TextBlock x:Name="HeaderStatusText" Text="Not checked yet" Foreground="#6B7280" FontSize="11" FontWeight="SemiBold" /></StackPanel></Border>
                </Grid>
            </Border>

            <ScrollViewer x:Name="OverviewPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="32,22,34,28">
                    <Border x:Name="BannerBorder" Visibility="Collapsed" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="9" Padding="14,10" Margin="0,0,0,14"><TextBlock x:Name="BannerText" Foreground="#1D4ED8" FontSize="12" TextWrapping="Wrap" /></Border>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.45*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid><StackPanel><TextBlock x:Name="AutoStatusTitle" Text="Automatic checks" Foreground="{DynamicResource TextBrush}" FontSize="16" FontWeight="SemiBold" /><TextBlock x:Name="AutoStatusDetail" Text="Checks automatically every 6 hours and at sign-in." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,5,0,0" /></StackPanel><CheckBox x:Name="AutomaticUpdatesToggle" Style="{StaticResource ToggleSwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" IsChecked="True" /></Grid>
                                <StackPanel x:Name="IntervalPanel" Grid.Row="2">
                                    <Slider x:Name="IntervalSlider" Style="{StaticResource IntervalSliderStyle}" Minimum="0" Maximum="4" Value="2" TickFrequency="1" IsSnapToTickEnabled="True" />
                                    <Grid x:Name="IntervalLabelsGrid" Height="28" Margin="0,-14,0,0" ClipToBounds="False"><Grid.ColumnDefinitions><ColumnDefinition Width="17" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="17" /></Grid.ColumnDefinitions><Border x:Name="IntervalHit1" Grid.Column="0" Grid.ColumnSpan="2" Width="34" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center" Background="Transparent" Cursor="Hand"><TextBlock x:Name="IntervalTick1" Width="64" Text="1 hour" TextAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Bottom" /></Border><Border x:Name="IntervalHit3" Grid.Column="1" Grid.ColumnSpan="2" Width="80" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent" Cursor="Hand"><TextBlock x:Name="IntervalTick3" Width="64" Text="3 hours" TextAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Bottom" /></Border><Border x:Name="IntervalHit6" Grid.Column="2" Grid.ColumnSpan="2" Width="80" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent" Cursor="Hand"><TextBlock x:Name="IntervalTick6" Width="64" Text="6 hours" TextAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Bottom" /></Border><Border x:Name="IntervalHit12" Grid.Column="3" Grid.ColumnSpan="2" Width="80" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent" Cursor="Hand"><TextBlock x:Name="IntervalTick12" Width="64" Text="12 hours" TextAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Bottom" /></Border><Border x:Name="IntervalHit24" Grid.Column="4" Grid.ColumnSpan="2" Width="34" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" Cursor="Hand"><TextBlock x:Name="IntervalTick24" Width="64" Text="24 hours" TextAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Bottom" /></Border></Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock Text="LAST RUN" Foreground="{DynamicResource MutedBrush}" FontSize="9" FontWeight="Bold" /><Grid Grid.Row="1" Margin="0,10,0,0"><TextBlock x:Name="LastRunDateText" Text="No run recorded" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold" /><TextBlock x:Name="LastRunTimeText" Text="" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Right" /></Grid><TextBlock x:Name="LastResultText" Grid.Row="2" Text="Run a check to get started." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" /></Grid>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <Grid><StackPanel><TextBlock x:Name="ActionCardTitle" Text="Check for updates" Foreground="{DynamicResource TextBrush}" FontSize="16" FontWeight="SemiBold" /><TextBlock x:Name="ActionCardSubtitle" Text="Check for available Winget updates or install selected updates." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,5,0,0" /></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="CheckButton" Content="Check only" Style="{StaticResource SecondaryButton}" Margin="0,0,9,0" /><Button x:Name="RunButton" Content="Install all updates" Style="{StaticResource PrimaryButton}" /></StackPanel><StackPanel x:Name="ProgressPanel" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,51,0,0" Visibility="Collapsed"><ProgressBar x:Name="ActionProgressBar" Width="104" Height="4" Minimum="0" Maximum="100" Value="0" IsIndeterminate="True" Foreground="#0891B2" Background="#CFFAFE" /><TextBlock x:Name="ProgressText" Text="Working..." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" Margin="11,-5,0,0" /><TextBlock x:Name="ProgressQueueText" Text="" Visibility="Collapsed" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" FontWeight="SemiBold" Margin="11,-5,0,0" /><TextBlock x:Name="ProgressPercentText" Text="" Visibility="Collapsed" Foreground="#0891B2" FontSize="10" FontWeight="SemiBold" Margin="10,-5,0,0" /></StackPanel></Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,14">
                        <StackPanel>
                            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="20,14"><Grid><StackPanel><TextBlock x:Name="AvailableUpdatesTitle" Text="Available updates" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold" /><TextBlock x:Name="AvailableUpdatesSubtitle" Text="Run Check only to refresh the package list." Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,3,0,0" /></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#ECFEFF" CornerRadius="14" Padding="10,5"><TextBlock x:Name="AvailableUpdatesCount" Text="Not scanned" Foreground="#0E7490" FontSize="10" FontWeight="SemiBold" /></Border></Grid></Border>
                            <TextBlock x:Name="AvailableUpdatesEmpty" Text="No update scan data yet." Foreground="{DynamicResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" Margin="20,24" />
                            <StackPanel x:Name="AvailableUpdatesList" Visibility="Collapsed">
                                <Border Background="{DynamicResource SurfaceAltBrush}" Padding="20,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="25" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Grid.Column="1" Text="APPLICATION" Foreground="{DynamicResource MutedBrush}" FontSize="8" FontWeight="Bold" /><TextBlock Grid.Column="2" Text="INSTALLED" Foreground="{DynamicResource MutedBrush}" FontSize="8" FontWeight="Bold" /><TextBlock Grid.Column="4" Text="AVAILABLE" Foreground="{DynamicResource MutedBrush}" FontSize="8" FontWeight="Bold" /><TextBlock Grid.Column="5" Text="SOURCE" Foreground="{DynamicResource MutedBrush}" FontSize="8" FontWeight="Bold" HorizontalAlignment="Right" /></Grid></Border>
                                <ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="AvailableUpdatesItems"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="20,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="25" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="{Binding Id}" HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip="Include this update in the next manual installation" /><StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Id}" Foreground="{DynamicResource MutedBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="9" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" /></StackPanel><TextBlock Grid.Column="2" Text="{Binding InstalledVersion}" Foreground="{DynamicResource SecondaryTextBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="10" VerticalAlignment="Center" /><TextBlock Grid.Column="3" Text="-&gt;" Foreground="#22D3EE" HorizontalAlignment="Center" VerticalAlignment="Center" /><TextBlock Grid.Column="4" Text="{Binding AvailableVersion}" Foreground="#0891B2" FontFamily="Cascadia Mono, Consolas" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" /><TextBlock Grid.Column="5" Text="{Binding Source}" Foreground="{DynamicResource MutedBrush}" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="TechnicalCommandBlock" Visibility="Collapsed" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="15,10" Margin="0,0,0,14">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="TechnicalCommandLabel" Text="COMMAND USED FOR UPDATES" Foreground="{DynamicResource MutedBrush}" FontSize="8" FontWeight="Bold" /><TextBlock x:Name="TechnicalCommandText" Text="" Foreground="{DynamicResource SecondaryTextBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="10" Margin="0,5,12,0" TextWrapping="Wrap" /></StackPanel><Button x:Name="CopyTechnicalCommandButton" Grid.Column="1" Content="Copy" Style="{StaticResource LinkButton}" VerticalAlignment="Center" /></Grid>
                    </Border>

                    <Border x:Name="TechnicalActivityBlock" Visibility="Collapsed" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,14">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="20,12"><Grid><StackPanel><TextBlock Text="Activity" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold" /><TextBlock Text="Latest output from the Winget update engine" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,3,0,0" /></StackPanel><Button x:Name="ActivityOpenLogButton" Content="Open log" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" VerticalAlignment="Center" IsEnabled="False" /></Grid></Border><TextBox x:Name="ActivityOutputTextBox" Grid.Row="1" Height="138" Text="No technical activity recorded yet." IsReadOnly="True" IsUndoEnabled="False" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource SecondaryTextBrush}" BorderThickness="0" Padding="20,12" FontFamily="Cascadia Mono, Consolas" FontSize="9.5" /></Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="HistoryPanel" Grid.Row="1" Visibility="Collapsed" Margin="32,22,34,24">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid Margin="0,0,0,14"><StackPanel><TextBlock Text="Previous update runs" Foreground="{DynamicResource TextBrush}" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="View results from previous checks and installations." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,0" /></StackPanel><Button x:Name="ClearHistoryButton" Content="Clear history" Style="{StaticResource DangerButton}" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
                <TextBlock x:Name="HistoryEmptyText" Grid.Row="1" Text="No update history has been recorded yet." Foreground="{DynamicResource MutedBrush}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <ListBox x:Name="HistoryList" Grid.Row="1" Visibility="Collapsed">
                    <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="108" /><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding DateText}" Foreground="{DynamicResource TextBrush}" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="{Binding TimeText}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,3,0,0" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="{Binding RunTypeText}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,3,0,0" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{Binding Message}" Foreground="{DynamicResource TextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding CountsText}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,3,0,0" /></StackPanel><StackPanel Grid.Column="3" HorizontalAlignment="Right"><TextBlock Text="{Binding DurationText}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" HorizontalAlignment="Right" /><TextBlock Text="{Binding RestartText}" Foreground="#F79009" FontSize="9" Margin="0,3,0,0" HorizontalAlignment="Right" /></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,6,0,0"><Grid><TextBlock x:Name="HistorySelectionHint" Text="Select a run to view its details or log." Foreground="{DynamicResource MutedBrush}" FontSize="10" VerticalAlignment="Center" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="HistoryDetailsButton" Content="Open details" Style="{StaticResource SecondaryButton}" IsEnabled="False" Margin="0,0,8,0" /><Button x:Name="HistoryLogButton" Content="Open log" Style="{StaticResource SecondaryButton}" IsEnabled="False" Margin="0,0,8,0" /><Button x:Name="DeleteHistoryButton" Content="Delete entry" Style="{StaticResource DangerButton}" IsEnabled="False" /></StackPanel></Grid></Border>
            </Grid>

            <ScrollViewer x:Name="SettingsPanel" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="32,22,34,28">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="Appearance" Foreground="{DynamicResource TextBrush}" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="Choose how Orbit looks." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,5,0,17" />
                        <Border x:Name="ThemeSystemOption" Cursor="Hand" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="14,11" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="11" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><RadioButton x:Name="ThemeSystemRadio" GroupName="ThemeChoice" IsChecked="True" VerticalAlignment="Center" /><StackPanel Grid.Column="2"><TextBlock Text="System default" Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="SemiBold" /><TextBlock Text="Use the Windows appearance setting." Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,2,0,0" /></StackPanel></Grid></Border>
                        <Border x:Name="ThemeLightOption" Cursor="Hand" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="14,11" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="11" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><RadioButton x:Name="ThemeLightRadio" GroupName="ThemeChoice" VerticalAlignment="Center" /><StackPanel Grid.Column="2"><TextBlock Text="Light" Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="SemiBold" /><TextBlock Text="Always use light appearance." Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,2,0,0" /></StackPanel></Grid></Border>
                        <Border x:Name="ThemeDarkOption" Cursor="Hand" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="14,11" Margin="0,0,0,17"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="11" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><RadioButton x:Name="ThemeDarkRadio" GroupName="ThemeChoice" VerticalAlignment="Center" /><StackPanel Grid.Column="2"><TextBlock Text="Dark" Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="SemiBold" /><TextBlock Text="Always use dark appearance." Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,2,0,0" /></StackPanel></Grid></Border>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Show taskbar status badge" Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="SemiBold" /><TextBlock Text="Show the current update status on the taskbar icon." Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,3,16,0" TextWrapping="Wrap" /></StackPanel><CheckBox x:Name="TaskbarStatusBadgeToggle" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
                    </StackPanel></Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="Automation" Foreground="{DynamicResource TextBrush}" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="Configure automatic updates and notifications." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,5,0,16" />
                        <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Automatic installation" Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="SemiBold" /><TextBlock Text="Install available updates automatically after scheduled checks." Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,3,16,0" TextWrapping="Wrap" /></StackPanel><CheckBox x:Name="AutomaticInstallationToggle" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
                        <Grid x:Name="StartupInstallationRow" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Install updates automatically when Orbit starts" Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="SemiBold" /><TextBlock Text="Check for and install available updates when Orbit starts." Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,3,16,0" TextWrapping="Wrap" /></StackPanel><CheckBox x:Name="StartupInstallationToggle" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Notify me when updates are available" Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="SemiBold" /><TextBlock Text="Show Windows notifications when updates are available." Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,3,16,0" TextWrapping="Wrap" /></StackPanel><CheckBox x:Name="NotificationsToggle" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
                    </StackPanel></Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Advanced" Foreground="{DynamicResource TextBrush}" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="Configure optional technical information." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,5,0,16" /><TextBlock Text="Show technical details" Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="SemiBold" /><TextBlock Text="Show Winget commands and technical activity on Overview." Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,3,0,0" /></StackPanel><CheckBox x:Name="TechnicalDetailsToggle" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,3" /></Grid></Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="History and logs" Foreground="{DynamicResource TextBrush}" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="Configure history and log retention." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,5,0,16" /><TextBlock Text="Keep history for" Foreground="{DynamicResource TextBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,9" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,17"><StackPanel Orientation="Horizontal" Margin="0,0,24,0"><RadioButton x:Name="Retention30Radio" GroupName="RetentionChoice" VerticalAlignment="Center" /><TextBlock Text="30 days" Foreground="{DynamicResource TextBrush}" FontSize="11" Margin="8,0,0,0" /></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,24,0"><RadioButton x:Name="Retention90Radio" GroupName="RetentionChoice" IsChecked="True" VerticalAlignment="Center" /><TextBlock Text="90 days" Foreground="{DynamicResource TextBrush}" FontSize="11" Margin="8,0,0,0" /></StackPanel><StackPanel Orientation="Horizontal"><RadioButton x:Name="RetentionUnlimitedRadio" GroupName="RetentionChoice" VerticalAlignment="Center" /><TextBlock Text="Unlimited" Foreground="{DynamicResource TextBrush}" FontSize="11" Margin="8,0,0,0" /></StackPanel></StackPanel>
                        <Grid><StackPanel><TextBlock Text="Delete associated raw log files" Foreground="{DynamicResource TextBrush}" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="Delete matching log files when history entries are removed." Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,3,0,0" /></StackPanel><CheckBox x:Name="DeleteLogsToggle" Style="{StaticResource ToggleSwitchStyle}" IsChecked="False" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid><Button x:Name="OpenLogFolderButton" Content="Open log folder" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,17,0,0" />
                    </StackPanel></Border>

                    <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Image x:Name="AboutLogo" Width="72" Height="72" Stretch="Uniform" /><StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="Orbit Updater" Foreground="{DynamicResource TextBrush}" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="Version 0.9.1-beta.1" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,5,0,0" /><TextBlock Text="A Windows utility for managing Winget updates." Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,4,0,0" /></StackPanel></Grid></Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
